# Camera BLE address
# Run ./scripts/discover_camera.sh to find likely candidates.
CAMERA_MAC="AA:BB:CC:DD:EE:FF"

# Camera temporary Wi-Fi
CAMERA_SSID="CEYOMUR-xxxxxxxxxxxx"
CAMERA_PASS="12345678"
CAMERA_IP="192.168.8.120"

# Camera HTTP folder path
CAMERA_PATH="/DCIM/100HUNTI"

# Optional: home Wi-Fi profile name in NetworkManager.
# If set, the script temporarily disables this Wi-Fi while connecting to the camera.
# Ethernet is recommended for the host.
HOME_WIFI_NAME="YourHomeWifi"

# Local folders
LOCAL_DIR="/home/pi/ceyomur-downloads"
LOG_DIR="/home/pi/ceyomur-logs"

# rclone destination
# Examples:
# RCLONE_DEST="gdrive:Cameras/Ceyomur"
# RCLONE_DEST="onedrive:Cameras/Ceyomur"
RCLONE_DEST="yourremote:Cameras/Ceyomur"

# Telegram notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Loop interval: 45 minutes = 2700 seconds
INTERVAL_SECONDS=2700

# Wi-Fi retry behavior
WIFI_MAX_ATTEMPTS=18
WIFI_WAIT_SECONDS=10
